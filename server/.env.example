NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=sudha_app
DB_PASSWORD=123_
DB_NAME=sudha_tourism
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# At least 16 characters; generate independently of JWT_SECRET.
IP_SALT=
# 0 = no proxy; a known hop count (1-10) or loopback/linklocal/uniquelocal.
TRUST_PROXY=0
# Optional, seed only. To create an admin provide both; password 12+ chars, <=72 UTF-8 bytes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP notifications. Disabled unless explicitly enabled.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
LEAD_NOTIFICATION_TO=
MAIL_FROM=
