# Public values only. Vite embeds these in the browser bundle at build time.
# Required before launch: the real public HTTPS origin, matching server CLIENT_URL.
VITE_SITE_URL=
# Empty uses relative /api requests. Separate origins must be HTTPS and same-site.
VITE_API_ORIGIN=
# Approved default sharing image: absolute HTTPS URL or a site-relative /path.
VITE_SOCIAL_IMAGE=
# Exact HTTPS image origins permitted by the deployment CSP. Temporary seed source:
VITE_IMAGE_ORIGINS=https://images.unsplash.com
